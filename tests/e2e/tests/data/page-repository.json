        { "elementName": "stockInfo", "selector": { "css": "[data-testid='book-detail-stock']" } }
      ]
    },
    {
      "name": "LoginPage",
      "elements": [
        { "elementName": "emailInput", "selector": { "css": "[data-testid='login-email']" } },
        { "elementName": "passwordInput", "selector": { "css": "[data-testid='login-password']" } },
        { "elementName": "submitButton", "selector": { "css": "[data-testid='login-submit']" } },
        { "elementName": "heading", "selector": { "text": "Welcome back" } },
        { "elementName": "signupLink", "selector": { "css": "main a[href='/signup']" } },
        { "elementName": "errorMessage", "selector": { "css": "[data-testid='login-error'], .error-message, .error" } }
      ]
    },
    {
      "name": "SignupPage",
      "elements": [
        { "elementName": "usernameInput", "selector": { "css": "[data-testid='signup-username']" } },
        { "elementName": "emailInput", "selector": { "css": "[data-testid='signup-email']" } },
        { "elementName": "passwordInput", "selector": { "css": "[data-testid='signup-password']" } },
        { "elementName": "submitButton", "selector": { "css": "[data-testid='signup-submit']" } },
        { "elementName": "heading", "selector": { "text": "Create an account" } },
        { "elementName": "loginLink", "selector": { "text": "Sign in" } },
        { "elementName": "errorMessage", "selector": { "css": "[data-testid='signup-error'], .error-message, .error" } }
      ]
    },
    {
      "name": "CartPage",
      "elements": [
        { "elementName": "cartPage", "selector": { "css": "[data-testid='cart-page']" } },
