        { "elementName": "loginLink", "selector": { "css": "[data-testid='nav-login']" } },
        { "elementName": "signupLink", "selector": { "css": "[data-testid='nav-signup']" } },
        { "elementName": "cartLink", "selector": { "css": "[data-testid='nav-cart']" } },
