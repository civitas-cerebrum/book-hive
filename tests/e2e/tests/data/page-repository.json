        { "elementName": "checkoutButton", "selector": { "css": "[data-testid='checkout-btn']" } },
        { "elementName": "cartItem", "selector": { "css": "[data-testid^='cart-item-']:not([data-testid*='-title']):not([data-testid*='-price'])" } },
        { "elementName": "heading", "selector": { "text": "Shopping Cart" } },
        { "elementName": "emptyMessage", "selector": { "text": "Your cart is empty" } }
      ]
    },
    {
      "name": "OrdersPage",
      "elements": [
        { "elementName": "ordersPage", "selector": { "css": "[data-testid='orders-page']" } },
        { "elementName": "noOrders", "selector": { "css": "[data-testid='no-orders']" } },
        { "elementName": "heading", "selector": { "text": "Your Orders" } },
        { "elementName": "orderCard", "selector": { "css": "[data-testid^='order-card-']" } },
        { "elementName": "noOrdersMessage", "selector": { "text": "No orders yet" } }
      ]
    },
    {
      "name": "OrderDetailPage",
      "elements": [
        { "elementName": "orderStatus", "selector": { "css": "[data-testid^='order-status-']" } },
        { "elementName": "orderItem", "selector": { "css": "[data-testid^='order-item-']" } },
        { "elementName": "returnButton", "selector": { "css": "[data-testid^='return-order-']" } }
      ]
    },
    {
      "name": "MarketplacePage",
      "elements": [
        { "elementName": "heading", "selector": { "css": "main h1" } },
        { "elementName": "noListings", "selector": { "text": "No listings available" } },
        { "elementName": "listingCard", "selector": { "css": "[data-testid^='listing-card-']" } },
        { "elementName": "buyButton", "selector": { "css": "[data-testid^='listing-buy-']" } }
