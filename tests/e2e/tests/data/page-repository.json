        { "elementName": "pageInfo", "selector": { "css": "[data-testid='pagination'] span, .page-info" } }
      ]
    },
    {
      "name": "BookDetailPage",
      "elements": [
        { "elementName": "bookTitle", "selector": { "css": "[data-testid='book-detail-title']" } },
